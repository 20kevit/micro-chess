DATABASE_URL=sqlite:///./microchess.db
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-free JSON list of allowed browser origins, e.g. '["http://localhost:5173"]'.
# CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
# Optional shared Lichess position source for Exercise 1 (read-only).
# When unset, backend looks for ./puzzles.db then ./backend/puzzles.db,
# else uses curated fallback positions.
# PUZZLES_DB_PATH=./puzzles.db
# Optional Lichess puzzle ingestion pipeline (offline tooling only:
# `python -m app.tools.lichess_puzzles.cli --help`). Never required for
# the normal FastAPI runtime; see docs/LICHESS_PUZZLES.md.
# LICHESS_PUZZLE_URL=https://database.lichess.org/lichess_db_puzzle.csv.zst
# LICHESS_PUZZLE_DATA_DIR=./data/lichess_puzzles
# LICHESS_PUZZLE_PROGRESS_EVERY=200000
# --- P11 onboarding/journey/notifications ---
# SMS provider: "test" (default, no real SMS) or "kavenegar".
# SMS_PROVIDER=test
# SMS_KAVENEGAR_API_KEY=
# SMS_KAVENEGAR_SENDER=
# Web Push (VAPID): generate with e.g. `python -c "from cryptography..."`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@microchess.ir
# Telegram bot (@BotFather): username for deep links + token for sending.
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN=
# Bale bot: username + token (same shape as Telegram; capabilities differ).
# BALE_BOT_USERNAME=
# BALE_BOT_TOKEN=
# Shared secret for bot webhooks (X-Bot-Secret header must match).
# BOT_WEBHOOK_SECRET=
