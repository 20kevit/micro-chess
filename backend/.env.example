DATABASE_URL=sqlite:///./microchess.db
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-free JSON list of allowed browser origins, e.g. '["http://localhost:5173"]'.
# CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
# Optional shared Lichess position source for Exercise 1 (read-only).
# When unset, backend looks for ./puzzles.db then ./backend/puzzles.db,
# else uses curated fallback positions.
# PUZZLES_DB_PATH=./puzzles.db
# Optional Lichess puzzle ingestion pipeline (offline tooling only:
# `python -m app.tools.lichess_puzzles.cli --help`). Never required for
# the normal FastAPI runtime; see docs/LICHESS_PUZZLES.md.
# LICHESS_PUZZLE_URL=https://database.lichess.org/lichess_db_puzzle.csv.zst
# LICHESS_PUZZLE_DATA_DIR=./data/lichess_puzzles
# LICHESS_PUZZLE_PROGRESS_EVERY=200000
# --- Free/Premium, verification & notifications ---
# Phone verification uses Telegram/Bale contact sharing (no SMS OTP,
# no Google login). Premium price default (minor units, IRR) applies
# only until the operator configures a real price version via admin.
# PREMIUM_PRICE_MINOR=990000
# Abuse-protection rates (requests/minute, in-memory).
# VERIFICATION_RATE_LIMIT_PER_MINUTE=20
# BILLING_RATE_LIMIT_PER_MINUTE=30
# WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Web Push (VAPID)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@microchess.ir
# Telegram bot (@BotFather): username for the app deep link + token for
# bot replies. Never commit real values.
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN=
# Optional per-bot webhook secret (Telegram secret_token header).
# TELEGRAM_WEBHOOK_SECRET=
# Bale bot: username + token (Telegram-compatible Bot API at tapi.bale.ai).
# BALE_BOT_USERNAME=
# BALE_BOT_TOKEN=
# Shared secret accepted by the verification webhook (X-Bot-Secret).
# BOT_WEBHOOK_SECRET=
