DATABASE_URL=sqlite:///./microchess.db
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-free JSON list of allowed browser origins, e.g. '["http://localhost:5173"]'.
# CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
# Optional shared Lichess position source for Exercise 1 (read-only).
# When unset, backend looks for ./puzzles.db then ./backend/puzzles.db,
# else uses curated fallback positions.
# PUZZLES_DB_PATH=./puzzles.db
